---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import type { HTMLTag, Polymorphic } from 'astro/types'

import { Icon } from 'astro-pure/user'

import { cn } from '../../utils'

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/content/blog/papers/**/*.{jpeg,jpg,png,gif}'
)

type Paper = {
  id: string
  data: {
    title: string
    subTitle?: string
    publishDate: string
    citations?: number
    doi?: string
    isbn?: string
    star?: number
    tags?: string[]
    titleImage?: {
      src: string
      alt?: string
      width?: number
      height?: number
    }
  }
  index?: number
}

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
  paper: Paper
  class?: string
}

const { as: Tag = 'div', paper, class: className } = Astro.props
const { id, data, index } = paper

let imagePath = null
let imageModule = null
if (data.titleImage) {
  const imagePathPrefix = `/src/content/blog/papers/${id}/${data.titleImage.src.replace('./', '')}`
  imagePath = images[imagePathPrefix]
  if (!imagePath) {
    throw new Error(
      `"${imagePathPrefix}" does not exist in glob: "src/content/blog/papers/**/*.{jpeg,jpg,png,gif}"`
    )
  }
  imageModule = await imagePath()
}

// 确保 star 值在 0-5 之间
const starCount = data.star ? Math.min(Math.max(data.star, 0), 5) : 0
---

<Tag
  class={cn(
    'group flex gap-6 p-6 rounded-xl transition-all duration-300 relative overflow-hidden',
    'bg-white dark:bg-zinc-900',
    'border border-zinc-100 dark:border-zinc-800',
    'hover:border-zinc-200 dark:hover:border-zinc-700',
    'mb-4', // 添加底部间距
    className
  )}
>
  {/* 背景序号 */}
  {
    typeof paper.index === 'number' && (
      <div
        class='absolute right-0 top-1/2 -translate-y-1/2 -translate-x-4 text-[100px] font-bold leading-none
      text-zinc-900/[0.04] dark:text-zinc-100/[0.06] select-none pointer-events-none'
      >
        {String(paper.index).padStart(2, '0')}
      </div>
    )
  }

  {/* Star 评分 - 右上角 */}
  {
    starCount > 0 && (
      <div class='absolute top-4 right-4 flex gap-0.5 z-20'>
        {Array.from({ length: 5 }).map((_, i) => (
          <Icon
            name='star'
            class={cn(
              'size-4',
              i < starCount ? 'text-yellow-400' : 'text-zinc-200 dark:text-zinc-700'
            )}
          />
        ))}
      </div>
    )
  }

  {/* 左侧图片 */}
  {
    imageModule && (
      <div class='relative shrink-0 z-10 self-stretch'>
        <img
          src={imageModule.default.src}
          alt={data.titleImage.alt || data.title}
          class='w-32 h-full object-cover rounded-lg'
          width='128'
          height='128'
          loading='lazy'
        />
      </div>
    )
  }

  {/* 右侧内容 */}
  <div class='flex flex-col flex-1 min-w-0 z-10'>
    {/* 标题区域 */}
    <div class='space-y-1'>
      <h3 class='text-lg font-medium text-zinc-900 dark:text-zinc-100 leading-tight m-0'>
        {data.title}
      </h3>
      {
        data.subTitle && (
          <p class='text-sm text-zinc-600 dark:text-zinc-400 leading-normal m-0'>{data.subTitle}</p>
        )
      }
    </div>

    {/* 元信息 - 发布日期和引用数 */}
    <div class='mt-2 flex items-center gap-4 text-sm text-zinc-500 dark:text-zinc-400'>
      <span class='flex items-center gap-1.5'>
        <Icon name='calendar' class='size-4' />
        {new Date(data.publishDate).getFullYear()}
      </span>
      {
        data.citations !== undefined && (
          <span class='flex items-center gap-1.5'>
            <Icon name='citation' class='size-4' />
            {data.citations.toLocaleString()} citations
          </span>
        )
      }
    </div>

    {/* 元信息 - DOI 和 ISBN */}
    <div class='mt-2 flex flex-wrap items-center gap-4 text-sm text-zinc-500 dark:text-zinc-400'>
      {/* DOI */}
      {
        data.doi && (
          <button
            class='group/doi flex items-center gap-1.5 hover:text-zinc-800 dark:hover:text-zinc-200'
            onclick={`navigator.clipboard.writeText('${data.doi}').then(() => {
              document.dispatchEvent(new CustomEvent('toast', { 
                detail: { message: 'DOI copied to clipboard!' }
              }))
            })`}
          >
            <Icon name='doi' class='size-4' />
            <code class='font-mono text-xs px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 group-hover/doi:bg-zinc-200 dark:group-hover/doi:bg-zinc-700'>
              {data.doi}
            </code>
          </button>
        )
      }
      {/* ISBN */}
      {
        data.isbn && (
          <button
            class='group/isbn flex items-center gap-1.5 hover:text-zinc-800 dark:hover:text-zinc-200'
            onclick={`navigator.clipboard.writeText('${data.isbn}').then(() => {
              document.dispatchEvent(new CustomEvent('toast', { 
                detail: { message: 'ISBN copied to clipboard!' }
              }))
            })`}
          >
            <Icon name='book' class='size-4' />
            <span class='flex items-center gap-1'>
              ISBN:
              <code class='font-mono text-xs px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 group-hover/isbn:bg-zinc-200 dark:group-hover/isbn:bg-zinc-700'>
                {data.isbn}
              </code>
            </span>
          </button>
        )
      }
    </div>

    {/* 标签 */}
    {
      data.tags && (
        <div class='mt-auto pt-4 flex flex-wrap gap-2'>
          {data.tags.map((tag: string) => (
            <span class='px-2 py-1 text-xs rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300'>
              {tag}
            </span>
          ))}
        </div>
      )
    }
  </div>
</Tag>

<style>
  .shrink-0 {
    width: 8rem;
  }
</style>
