---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import type { HTMLTag, Polymorphic } from 'astro/types'

import { cn } from '../../utils'
import { Icon } from '../user'

// 获取所有论文相关的图片
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/content/blog/papers/**/*.{jpeg,jpg,png,gif}'
)

type Paper = {
  id: string
  data: {
    title: string
    publishDate: Date
    journal: string
    doi?: string
    tags?: string[]
    titleImage: {
      src: string
      alt?: string
      width?: number
      height?: number
    }
  }
}

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
  paper: Paper
  class?: string
}

const { as: Tag = 'div', paper, class: className } = Astro.props
const { id, data } = paper

// 处理图片路径
const imagePathPrefix = `/src/content/blog/papers/${id}/${data.titleImage.src.replace('./', '')}`
const imagePath = images[imagePathPrefix]
if (!imagePath) {
  throw new Error(
    `"${imagePathPrefix}" does not exist in glob: "src/content/blog/papers/**/*.{jpeg,jpg,png,gif}"`
  )
}
---

<Tag
  class={cn(
    'group flex gap-6 p-6 rounded-xl transition-all duration-300',
    'bg-white dark:bg-zinc-900',
    'border border-zinc-100 dark:border-zinc-800',
    'hover:border-zinc-200 dark:hover:border-zinc-700',
    className
  )}
>
  {/* 左侧图片 */}
  {
    imagePath && (
      <div class='shrink-0'>
        <Image
          src={imagePath().then((mod) => mod.default)}
          alt={data.titleImage.alt || data.title}
          class='w-32 h-32 object-cover rounded-lg'
          width={data.titleImage.width || 400}
          height={data.titleImage.height || 300}
        />
      </div>
    )
  }

  {/* 右侧内容 */}
  <div class='flex flex-col flex-1 min-w-0'>
    {/* 标题 */}
    <h3 class='text-lg font-medium text-zinc-900 dark:text-zinc-100'>
      {data.title}
    </h3>

    {/* 期刊和年份 */}
    <div class='mt-2 flex items-center gap-4 text-sm text-zinc-500 dark:text-zinc-400'>
      <span class='flex items-center gap-1.5'>
        <Icon name='book' class='size-4' />
        {data.journal}
      </span>
      <span class='flex items-center gap-1.5'>
        <Icon name='calendar' class='size-4' />
        {new Date(data.publishDate).getFullYear()}
      </span>
    </div>

    {/* 副标题 */}
    {
      data.subtitle && (
        <p class='mt-3 text-sm text-zinc-600 dark:text-zinc-300 line-clamp-2'>{data.subtitle}</p>
      )
    }

    {/* 底部信息 */}
    <div class='mt-auto pt-4 flex items-center justify-between'>
      {/* Tags */}
      {
        data.tags && (
          <div class='flex flex-wrap gap-2'>
            {data.tags.map((tag: string) => (
              <span class='px-2 py-1 text-xs rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300'>
                {tag}
              </span>
            ))}
          </div>
        )
      }

      {/* DOI */}
      {
        data.doi && (
          <a
            href={`https://doi.org/${data.doi}`}
            target='_blank'
            rel='noopener noreferrer'
            class='flex items-center gap-1.5 text-sm text-zinc-500 hover:text-zinc-800 dark:text-zinc-400 dark:hover:text-zinc-200'
          >
            <Icon name='external-link' class='size-4' />
            <span>DOI</span>
          </a>
        )
      }
    </div>
  </div>
</Tag>
