---
import Paper from '@/custom/components/pages/Paper.astro'

import PageLayout from '@/layouts/BaseLayout.astro'

const papers = [
  {
    id: 'paper-1',
    data: {
      title: 'An Example Research Paper Title',
      publishDate: new Date('2024-01-15'),
      journal: 'Nature',
      doi: '10.1038/example',
      tags: ['AI', 'Machine Learning'],
      titleImage: {
        src: '/images/papers/paper1-title.png',
        alt: 'Paper 1 Title Screenshot'
      }
    }
  }
  // Add more papers...
]
---

<PageLayout>
  <main class='container mx-auto py-8'>
    <h1 class='text-3xl font-bold mb-8'>Research Papers</h1>
    <ul class='space-y-6'>
      {papers.map((paper) => <Paper paper={paper} />)}
    </ul>
  </main>
</PageLayout>
