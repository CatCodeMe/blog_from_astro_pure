// 按年份分组
const catsByYear = cats.reduce(
  (acc, cat) => {
    const year = new Date(cat.date).getFullYear()
    if (!acc[year]) acc[year] = []
    acc[year].push(cat)
    return acc
  },
  {} as Record<number, CatPhoto[]>
)

const sortedYears = Object.keys(catsByYear)
  .map(Number)
  .sort((a, b) => b - a)
---

<GalleryLayout title='Cat Gallery'>
  <div class='photo-wall'>
    {
      sortedYears.map((year, yearIndex) => (
        <section class='year-section'>
          <div class='year-header'>
            <h2 class='year-title'>{year}</h2>
            <span class='photo-count'>
              {catsByYear[year].length} photo{catsByYear[year].length > 1 && 's'}
            </span>
          </div>
          <div class='photos-grid'>
            {catsByYear[year].map((cat, index) => (
              <div
                class='photo-item'
                style={`--delay: ${index * 0.1}s; --rotate: ${Math.random() * 8 - 4}deg;`}
                data-photo-id={`${year}-${index}`}
              >
                <div class='photo-frame'>
                  <Image
                    src={cat.image}
                    alt={cat.name}
                    width={300}
                    height={300}
                    class='cat-photo'
                    loading={yearIndex === 0 ? 'eager' : 'lazy'}
                    decoding={yearIndex === 0 ? 'sync' : 'async'}
                    format='webp'
                    quality={80}
                    densities={[1, 2]}
                    sizes='(max-width: 500px) 100vw, (max-width: 900px) 50vw, 33vw'
                  />
                </div>
              </div>
            ))}
          </div>
        </section>
      ))
    }
  </div>

  <!-- 模态窗口 -->
  <div class='photo-modal' id='photo-modal'>
    <div class='modal-overlay'></div>
    <div class='modal-content'>
      <button class='close-button' aria-label='关闭'>&times;</button>
      <div class='modal-body'>
        <div class='modal-image-container'>
          <Image
            src={catAvatar}
            alt=''
            width={800}
            height={800}
            class='modal-photo'
            loading='lazy'
            decoding='async'
            format='webp'
            quality={90}
            densities={[1, 2]}
            sizes='(max-width: 768px) 95vw, 70vw'
          />
        </div>
        <div class='modal-info'>
          <h2 class='modal-title'></h2>
          <div class='modal-details' id='modal-details'>
            <!-- 属性将通过JavaScript动态生成 -->
          </div>
        </div>
      </div>
    </div>
  </div>
</GalleryLayout>

<style>
  /* 滚动锁定相关样式 */
  :root {
    --scrollbar-width: 0px;
  }

  html.scroll-locked {
    overflow: hidden;
    padding-right: var(--scrollbar-width);
  }

  html.scroll-locked body {
    overflow: hidden;
  }

  .photo-wall {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    margin-bottom: 2rem; /* 与footer保持距离 */
  }

  .year-section {
    margin-top: 2rem;
    position: relative;
  }

  .year-header {
    display: flex;
    align-items: baseline;
    margin-bottom: 1rem;
    padding-left: 0.5rem;
  }

  .year-title {
    font-size: 1.75rem;
    font-weight: 600;
    color: hsl(var(--foreground));
    margin: 0;
  }

  .photo-count {
    font-size: 1rem;
    color: hsl(var(--muted-foreground));
    margin-left: 1rem;
  }

  .photos-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 1.25rem;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 0.5rem;
  }

  .photo-item {
    animation: fadeIn 0.5s ease-out forwards;
    animation-delay: var(--delay);
    opacity: 0;
    transform: rotate(var(--rotate));
    aspect-ratio: 1;
    cursor: pointer;
    min-width: 0;
  }

  .photo-frame {
    background: hsl(var(--background));
    padding: 0.5rem;
    border: 2px solid hsl(var(--border));
    border-radius: 8px;
    box-shadow: 0 3px 6px rgba(0, 0, 0, 0.15);
    transition: all 0.3s ease;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;

    &:hover {
      transform: translateY(-3px);
      border-color: hsl(var(--primary) / 0.7);
      box-shadow:
        0 0 0 2px hsl(var(--primary) / 0.4),
        0 6px 12px rgba(0, 0, 0, 0.15);
    }
  }

  .cat-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 4px;
    transition: transform 0.3s ease;

    &:hover {
      transform: scale(1.05);
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px) rotate(var(--rotate));
    }
    to {
      opacity: 1;
      transform: translateY(0) rotate(var(--rotate));
    }
  }

  /* 响应式布局 */
  @media (max-width: 1400px) {
    .photos-grid {
      grid-template-columns: repeat(6, 1fr);
    }

    .photo-wall {
      max-height: calc(100vh - 180px);
    }
  }

  @media (max-width: 1200px) {
    .photos-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  @media (max-width: 900px) {
    .photos-grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .photo-wall {
      max-height: calc(100vh - 160px);
    }
  }

  @media (max-width: 700px) {
    .photos-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }

    .photo-wall {
      gap: 2rem;
    }

    .year-title {
      font-size: 1.5rem;
    }
  }

  @media (max-width: 500px) {
    .photos-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .photo-wall {
      max-height: calc(100vh - 140px);
      padding-right: 0.5rem;
    }
  }

  .photo-detail {
    position: sticky;
    top: 2rem;
    height: fit-content;
    width: 100%;
    box-sizing: border-box;
  }

  .detail-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .image-container {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 3px 6px rgba(0, 0, 0, 0.1);
  }

  .detail-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .image-container:hover .detail-photo {
    transform: scale(1.03);
  }

  .info-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .photo-name {
    font-size: 1.5rem;
    font-weight: 600;
    color: hsl(var(--foreground));
    margin: 0;
  }

  .photo-info {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .info-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .label {
    font-size: 0.875rem;
    color: hsl(var(--muted-foreground));
  }

  @media (max-width: 1200px) {
    .photo-detail {
      padding: 1rem;
    }

    .detail-content {
      gap: 1rem;
    }
  }

  @media (max-width: 900px) {
    .photo-detail {
      position: relative;
      top: 0;
      margin-bottom: 2rem;
    }
  }

  /* 模态窗口样式 */
  .photo-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: none;
    z-index: 1000;
    box-sizing: border-box;
  }

  /* 确保模态窗口在滚动锁定时不受影响 */
  html.scroll-locked .photo-modal {
    padding-right: var(--scrollbar-width);
  }

  .photo-modal.active {
    display: block;
  }

  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: hsl(var(--background) / 0.8);
    backdrop-filter: blur(4px);
  }

  .modal-content {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 70%;
    max-width: 70vw;
    max-height: 70vh;
    background: hsl(var(--background));
    border-radius: 12px;
    padding: 2rem;
    z-index: 1001;
    overflow: hidden; /* 防止滚动条出现 */
    box-shadow:
      0 0 0 1px hsl(var(--border)),
      0 10px 25px rgba(0, 0, 0, 0.2);
    animation: modalFadeIn 0.3s ease-out;
    display: flex;
    flex-direction: column;
  }

  .close-button {
    position: absolute;
    top: 1rem;
    right: 1rem;
    font-size: 1.5rem;
    background: hsl(var(--muted));
    border: 1px solid hsl(var(--border));
    color: hsl(var(--foreground));
    cursor: pointer;
    z-index: 1002;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: all 0.2s ease;
    padding: 0;
    line-height: 1;
  }

  .close-button:hover {
    background-color: hsl(var(--muted-foreground) / 0.1);
    color: hsl(var(--primary));
    border-color: hsl(var(--primary) / 0.3);
  }

  .modal-body {
    display: flex;
    gap: 2rem;
    flex-direction: column;
    align-items: center;
    height: 100%;
    overflow: hidden; /* 防止滚动条出现 */
  }

  @media (min-width: 768px) {
    .modal-body {
      flex-direction: row;
      align-items: center;
    }
  }

  .modal-image-container {
    flex: 1;
    border-radius: 12px;
    overflow: hidden;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    max-height: 60vh;
  }

  .modal-photo {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    border-radius: 12px;
  }

  .modal-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .modal-title {
    font-size: 1.8rem;
    font-weight: 600;
    margin: 0;
    color: hsl(var(--foreground));
  }

  .modal-details {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1rem;
  }

  .info-item {
    margin-bottom: 0.5rem;
  }

  .value {
    font-size: 1.1rem;
    color: hsl(var(--foreground));
    font-weight: 500;
  }

  @keyframes modalFadeIn {
    from {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
  }

  /* 添加一些基本的响应式设计 */
  @media (max-width: 768px) {
    .modal-body {
      flex-direction: column;
    }

    .modal-content {
      padding: 1.5rem;
      width: 90%;
      max-width: 90vw;
    }

    .modal-image-container {
      max-height: 45vh;
    }
  }

  @media (max-width: 480px) {
    .modal-content {
      padding: 1rem;
      width: 95%;
      max-width: 95vw;
    }

    .modal-image-container {
      max-height: 40vh;
    }
  }
</style>

<script is:inline define:vars={{ catsByYear }}>
  // 在页面加载后初始化
  document.addEventListener('DOMContentLoaded', () => {
    // 获取模态窗口元素
    const modal = document.getElementById('photo-modal')
    const modalTitle = modal.querySelector('.modal-title')
    const modalPhoto = modal.querySelector('.modal-photo')
    const closeButton = modal.querySelector('.close-button')
    const modalOverlay = modal.querySelector('.modal-overlay')
    const htmlEl = document.documentElement

    // 计算滚动条宽度并存储为CSS变量
    const scrollbarWidth = window.innerWidth - htmlEl.clientWidth
    htmlEl.style.setProperty('--scrollbar-width', `${scrollbarWidth}px`)

    // 添加类来控制滚动锁定
    function lockScroll() {
      if (!htmlEl.classList.contains('scroll-locked')) {
        htmlEl.classList.add('scroll-locked')
      }
    }

    function unlockScroll() {
      htmlEl.classList.remove('scroll-locked')
    }

    // 打开模态窗口的函数
    function openModal(cat) {
      // 设置标题和图片
      modalTitle.textContent = cat.name

      // 使用优化后的图片URL
      if (cat.image.src) {
        modalPhoto.src = cat.image.src
      } else if (cat.image) {
        // 如果图片对象没有src属性，可能是因为它还没有被处理
        modalPhoto.src = cat.image
      }

      modalPhoto.alt = cat.name

      // 清空并动态生成属性列表
      const detailsContainer = document.getElementById('modal-details')
      detailsContainer.innerHTML = ''

      // 遍历cat对象的所有属性，排除name和image
      for (const [key, value] of Object.entries(cat)) {
        // 跳过name和image属性，因为它们已经在其他地方显示
        if (key === 'name' || key === 'image') continue

        // 创建属性项
        const infoItem = document.createElement('div')
        infoItem.className = 'info-item'

        // // 创建标签
        // const label = document.createElement('span')
        // label.className = 'label'
        // label.textContent = key.charAt(0).toUpperCase() + key.slice(1) // 首字母大写

        // 创建值
        const valueSpan = document.createElement('span')
        valueSpan.className = 'value'

        // 如果是日期属性，格式化显示
        if (key === 'date') {
          valueSpan.textContent = new Date(value).toLocaleDateString()
        } else {
          valueSpan.textContent = value
        }

        // 添加到属性项
        // infoItem.appendChild(label)
        infoItem.appendChild(valueSpan)

        // 添加到容器
        detailsContainer.appendChild(infoItem)
      }

      // 锁定滚动
      lockScroll()

      // 显示模态窗口
      modal.classList.add('active')
    }

    // 关闭模态窗口的函数
    function closeModal() {
      modal.classList.remove('active')

      // 延时解锁滚动，等待模态窗口动画完成
      setTimeout(() => {
        unlockScroll()
      }, 300)
    }

    // 绑定关闭按钮事件
    closeButton.addEventListener('click', closeModal)
    modalOverlay.addEventListener('click', closeModal)

    // 绑定 ESC 键关闭模态窗口
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('active')) {
        closeModal()
      }
    })

    // 绑定缩略图点击事件
    document.querySelectorAll('.photo-item').forEach((item) => {
      item.addEventListener('click', () => {
        const [year, index] = item.getAttribute('data-photo-id').split('-')
        const cat = catsByYear[year][parseInt(index)]

        // 打开模态窗口
        openModal(cat)

        // 更新选中状态
        document.querySelectorAll('.photo-item').forEach((i) => i.classList.remove('selected'))
        item.classList.add('selected')
      })
    })
  })
</script>

<style>
  .photo-item.selected .photo-frame {
    border-color: hsl(var(--primary));
    box-shadow:
      0 0 0 1px hsl(var(--primary)),
      0 4px 8px rgba(0, 0, 0, 0.1);
    transform: translateY(-2px);
  }

  /* 响应式调整 */
  @media (max-width: 1200px) {
    .gallery-container {
      grid-template-columns: 1fr 350px;
    }
  }

  @media (max-width: 900px) {
    .gallery-container {
      grid-template-columns: 1fr;
    }

    .photos-grid {
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    }
  }

  @media (max-width: 600px) {
    .photos-grid {
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 1rem;
    }

    .photo-frame {
      padding: 0.5rem;
    }
  }
</style>
