---
import { Image } from 'astro:assets'

import GalleryLayout from '@/layouts/GalleryLayout.astro'
// Import cat photo configuration
import { cats, getSortedYears, groupCatsByYear } from '@/assets/cats/config'

// Process cat data
const catsByYear = groupCatsByYear(cats)
const sortedYears = getSortedYears(catsByYear)
---

<GalleryLayout title='Cat Gallery'>
  <div class='photo-wall'>
    {
      sortedYears.map((year, yearIndex) => (
        <section class='year-section'>
          <div class='year-header'>
            <h2 class='year-title'>{year}</h2>
            <span class='photo-count'>
              {catsByYear[year].length} photo{catsByYear[year].length > 1 && 's'}
            </span>
          </div>
          <div class='photos-grid'>
            {catsByYear[year].map((cat, index) => (
              <div
                class='photo-item'
                style={`--delay: ${index * 0.1}s; --rotate: ${Math.random() * 8 - 4}deg;`}
                data-photo-id={`${year}-${index}`}
              >
                <div class='photo-frame'>
                  <Image
                    src={cat.image}
                    alt={cat.name || 'Cat photo'}
                    width={300}
                    height={300}
                    class='cat-photo'
                    loading={yearIndex === 0 ? 'eager' : 'lazy'}
                    decoding={yearIndex === 0 ? 'sync' : 'async'}
                    format='webp'
                    quality={80}
                    densities={[1, 2]}
                    sizes='(max-width: 500px) 100vw, (max-width: 900px) 50vw, 33vw'
                  />
                </div>
              </div>
            ))}
          </div>
        </section>
      ))
    }
  </div>

  <!-- 模态窗口 -->
  <div class='photo-modal' id='photo-modal'>
    <div class='modal-overlay'></div>
    <div class='modal-content'>
      <div class='modal-body'>
        <div class='modal-image-container'>
          <img src='' alt='' class='modal-photo' loading='lazy' decoding='async' />
        </div>
        <div class='modal-info'>
          <h2 class='modal-title'></h2>
          <div class='modal-details' id='modal-details'>
            <!-- 属性将通过JavaScript动态生成 -->
          </div>
        </div>
      </div>
    </div>
  </div>
</GalleryLayout>

<style>
  /* 移除滚动锁定相关样式 */

  .photo-wall {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    margin-bottom: 2rem; /* 与footer保持距离 */
  }

  .year-section {
    margin-top: 2rem;
    position: relative;
  }

  .year-header {
    display: flex;
    align-items: baseline;
    margin-bottom: 1rem;
    padding-left: 0.5rem;
  }

  .year-title {
    font-size: 1.75rem;
    font-weight: 600;
    color: hsl(var(--foreground));
    margin: 0;
  }

  .photo-count {
    font-size: 1rem;
    color: hsl(var(--muted-foreground));
    margin-left: 1rem;
  }

  .photos-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 1.25rem;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 0.5rem;
  }

  .photo-item {
    animation: fadeIn 0.5s ease-out forwards;
    animation-delay: var(--delay);
    opacity: 0;
    transform: rotate(var(--rotate));
    aspect-ratio: 1;
    cursor: pointer;
    min-width: 0;
  }

  .photo-frame {
    background: hsl(var(--background));
    padding: 0.5rem;
    border: 2px solid hsl(var(--border));
    border-radius: 8px;
    box-shadow: 0 3px 6px rgba(0, 0, 0, 0.15);
    transition: all 0.3s ease;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;

    &:hover {
      transform: translateY(-3px);
      border-color: hsl(var(--primary) / 0.7);
      box-shadow:
        0 0 0 2px hsl(var(--primary) / 0.4),
        0 6px 12px rgba(0, 0, 0, 0.15);
    }
  }

  .cat-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 4px;
    transition: transform 0.3s ease;

    &:hover {
      transform: scale(1.05);
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px) rotate(var(--rotate));
    }
    to {
      opacity: 1;
      transform: translateY(0) rotate(var(--rotate));
    }
  }

  /* 响应式布局 */
  /* 照片墙响应式布局 */
  @media (max-width: 1400px) {
    .photos-grid {
      grid-template-columns: repeat(6, 1fr);
    }
  }
  @media (max-width: 1200px) {
    .photos-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  @media (max-width: 900px) {
    .photos-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 700px) {
    .photos-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
    .photo-wall {
      gap: 2rem;
    }
    .year-title {
      font-size: 1.5rem;
    }
  }

  @media (max-width: 500px) {
    .photos-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .photo-wall {
      padding-right: 0.5rem;
    }
  }

  .photo-detail {
    position: sticky;
    top: 2rem;
    height: fit-content;
    width: 100%;
    box-sizing: border-box;
  }

  .detail-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .image-container {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 3px 6px rgba(0, 0, 0, 0.1);
  }

  .detail-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .image-container:hover .detail-photo {
    transform: scale(1.03);
  }

  .info-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .photo-name {
    font-size: 1.5rem;
    font-weight: 600;
    color: hsl(var(--foreground));
    margin: 0;
  }

  .photo-info {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .info-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .label {
    font-size: 0.875rem;
    color: hsl(var(--muted-foreground));
  }

  @media (max-width: 1200px) {
    .photo-detail {
      padding: 1rem;
    }

    .detail-content {
      gap: 1rem;
    }
  }

  @media (max-width: 900px) {
    .photo-detail {
      position: relative;
      top: 0;
      margin-bottom: 2rem;
    }
  }

  /* 模态窗口样式 */
  .photo-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0.3s ease;
    z-index: 1000;
    box-sizing: border-box;
  }

  .photo-modal.active {
    opacity: 1;
    visibility: visible;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: hsl(var(--background) / 0.8);
    backdrop-filter: blur(4px);
  }

  .modal-content {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.95);
    width: 80%;
    max-width: 80vw;
    max-height: 80vh;
    background: hsl(var(--background));
    border: 1px solid hsl(var(--border));
    border-radius: 8px;
    padding: 1.5rem;
    z-index: 1001;
    overflow: hidden; /* 防止滚动条出现 */
    opacity: 0;
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  .photo-modal.active .modal-content {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  /* 模态窗口内容过渡效果 */
  .modal-photo {
    transition: opacity 0.3s ease;
  }

  .modal-photo.transitioning {
    opacity: 0;
  }

  /* 关闭按钮已移除 */

  .modal-body {
    display: flex;
    gap: 2rem;
    flex-direction: column;
    align-items: center;
    height: 100%;
    overflow: hidden; /* 防止滚动条出现 */
    width: 100%;
  }

  @media (min-width: 768px) {
    .modal-body {
      flex-direction: row;
      align-items: center;
    }
  }

  .modal-image-container {
    flex: 1;
    overflow: hidden;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    max-height: 60vh;
    background-color: transparent;
  }

  .modal-photo {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    border-radius: 4px;
  }

  .modal-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .modal-title {
    font-size: 1.8rem;
    font-weight: 600;
    margin: 0;
    color: hsl(var(--foreground));
  }

  .modal-details {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1rem;
  }

  .info-item {
    margin-bottom: 0.75rem;
  }

  .label {
    font-size: 0.875rem;
    color: hsl(var(--muted-foreground));
    margin-bottom: 0.25rem;
    display: none; /* 隐藏所有标签 */
  }

  .value {
    font-size: 1.1rem;
    color: hsl(var(--foreground));
    font-weight: 500;
    line-height: 1.4;
  }

  /* 标签样式 */
  .tag-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .tag-item {
    background: hsl(var(--primary) / 0.1);
    color: hsl(var(--primary));
    border: 1px solid hsl(var(--primary) / 0.2);
    border-radius: 4px;
    padding: 0.25rem 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    transition: all 0.2s ease;
  }

  /* 移除不需要的动画关键帧 */

  /* 响应式设计 */
  @media (max-width: 768px) {
    .modal-body {
      flex-direction: column;
    }
    .modal-content {
      padding: 1rem;
      width: 95%;
      max-width: 95vw;
    }
    .modal-image-container {
      max-height: 50vh;
      padding: 0;
    }
  }

  @media (max-width: 480px) {
    .modal-content {
      padding: 0.75rem;
      width: 98%;
      max-width: 98vw;
    }
    .modal-image-container {
      max-height: 45vh;
    }
  }
</style>

<script is:inline define:vars={{ catsByYear, sortedYears }}>
  document.addEventListener('DOMContentLoaded', () => {
    // 获取元素
    const modal = document.getElementById('photo-modal')
    const modalTitle = modal.querySelector('.modal-title')
    const modalPhoto = modal.querySelector('.modal-photo')
    const modalInfo = modal.querySelector('.modal-info')
    const modalOverlay = modal.querySelector('.modal-overlay')

    // 当前选中的照片信息
    let currentYear, currentIndex

    // 获取所有照片项
    const allPhotoItems = document.querySelectorAll('.photo-item')

    // 打开模态窗口函数
    function openModal(cat, photoItem) {
      // 获取当前照片的年份和索引
      const photoId = photoItem.getAttribute('data-photo-id')
      ;[currentYear, currentIndex] = photoId.split('-').map((val) => parseInt(val))

      // 确保图片可见
      modalPhoto.classList.remove('transitioning')

      // 设置标题和图片
      if (cat.name) {
        modalTitle.textContent = cat.name
        modalInfo.style.display = 'flex' // 显示信息区域
      } else {
        modalTitle.textContent = ''
        modalInfo.style.display = 'none' // 隐藏信息区域
      }

      // 对于普通的img标签，我们需要直接使用优化后的图片URL
      // 添加判断防止图片源格式不符合预期
      modalPhoto.src = cat.image.src || (typeof cat.image === 'string' ? cat.image : '')
      modalPhoto.alt = cat.name || 'Cat photo'

      // 生成属性列表
      const detailsContainer = document.getElementById('modal-details')
      detailsContainer.innerHTML = ''

      // 遍历属性并创建元素
      Object.entries(cat).forEach(([key, value]) => {
        // 跳过name、image和空值
        if (key === 'name' || key === 'image' || !value) return

        const infoItem = document.createElement('div')
        infoItem.className = 'info-item'

        // 创建标签元素
        const labelSpan = document.createElement('span')
        labelSpan.className = 'label'
        labelSpan.style.display = 'none' // 隐藏所有属性名称

        // 创建值元素
        const valueSpan = document.createElement('span')
        valueSpan.className = 'value'

        // 根据不同的属性类型处理显示
        if (key === 'date') {
          // 只显示日期
          valueSpan.textContent = new Date(value).toLocaleDateString()
        } else if (key === 'tag' && Array.isArray(value)) {
          // 创建标签容器
          const tagContainer = document.createElement('div')
          tagContainer.className = 'tag-container'

          // 为每个标签创建标签元素
          value.forEach((tag) => {
            const tagItem = document.createElement('span')
            tagItem.className = 'tag-item'
            tagItem.textContent = tag
            tagContainer.appendChild(tagItem)
          })

          // 添加标签容器而不是纯文本
          valueSpan.textContent = ''
          valueSpan.appendChild(tagContainer)
        } else if (typeof value === 'string') {
          valueSpan.textContent = value
        } else {
          valueSpan.textContent = JSON.stringify(value)
        }

        infoItem.appendChild(labelSpan)
        infoItem.appendChild(valueSpan)
        detailsContainer.appendChild(infoItem)
      })

      // 显示模态窗口
      modal.classList.add('active')

      // 更新选中状态
      allPhotoItems.forEach((item) => item.classList.remove('selected'))
      photoItem.classList.add('selected')
    }

    // 关闭模态窗口函数
    const closeModal = () => {
      modal.classList.remove('active')
      currentYear = null
      currentIndex = null
    }

    // 切换到下一张或上一张照片
    function navigatePhotos(direction) {
      if (currentYear === null || currentIndex === null) return

      // 添加过渡效果
      modalPhoto.classList.add('transitioning')

      // 延迟加载新照片，等待淡出效果完成
      setTimeout(() => {
        const currentYearPhotos = catsByYear[currentYear]
        let newIndex = currentIndex + direction
        let newYear = currentYear

        // 如果超出当前年份的照片范围，则切换到下一个/上一个年份
        if (newIndex < 0 || newIndex >= currentYearPhotos.length) {
          const yearIndex = sortedYears.indexOf(currentYear)

          if (direction > 0 && yearIndex > 0) {
            // 向后导航到上一年（因为年份是降序排列的）
            newYear = sortedYears[yearIndex - 1]
            newIndex = 0
          } else if (direction < 0 && yearIndex < sortedYears.length - 1) {
            // 向前导航到下一年（因为年份是降序排列的）
            newYear = sortedYears[yearIndex + 1]
            newIndex = catsByYear[newYear].length - 1
          } else {
            // 如果已经是第一张或最后一张照片，则循环到另一端
            if (direction > 0) {
              newYear = sortedYears[sortedYears.length - 1]
              newIndex = 0
            } else {
              newYear = sortedYears[0]
              newIndex = catsByYear[newYear].length - 1
            }
          }
        }

        // 找到对应的照片元素
        const photoItem = document.querySelector(`[data-photo-id="${newYear}-${newIndex}"]`)
        if (photoItem) {
          const cat = catsByYear[newYear][newIndex]

          // 更新图片和信息
          if (cat.name) {
            modalTitle.textContent = cat.name
            modalInfo.style.display = 'flex'
          } else {
            modalTitle.textContent = ''
            modalInfo.style.display = 'none'
          }

          // 更新图片源
          modalPhoto.src = cat.image.src || (typeof cat.image === 'string' ? cat.image : '')
          modalPhoto.alt = cat.name || 'Cat photo'

          // 更新属性列表
          const detailsContainer = document.getElementById('modal-details')
          detailsContainer.innerHTML = ''

          // 遍历属性并创建元素
          Object.entries(cat).forEach(([key, value]) => {
            // 跳过name、image和空值
            if (key === 'name' || key === 'image' || !value) return

            const infoItem = document.createElement('div')
            infoItem.className = 'info-item'

            // 创建标签元素
            const labelSpan = document.createElement('span')
            labelSpan.className = 'label'
            labelSpan.style.display = 'none' // 隐藏所有属性名称

            // 创建值元素
            const valueSpan = document.createElement('span')
            valueSpan.className = 'value'

            // 根据不同的属性类型处理显示
            if (key === 'date') {
              // 只显示日期
              valueSpan.textContent = new Date(value).toLocaleDateString()
            } else if (key === 'tag' && Array.isArray(value)) {
              // 创建标签容器
              const tagContainer = document.createElement('div')
              tagContainer.className = 'tag-container'

              // 为每个标签创建标签元素
              value.forEach((tag) => {
                const tagItem = document.createElement('span')
                tagItem.className = 'tag-item'
                tagItem.textContent = tag
                tagContainer.appendChild(tagItem)
              })

              // 添加标签容器而不是纯文本
              valueSpan.textContent = ''
              valueSpan.appendChild(tagContainer)
            } else if (typeof value === 'string') {
              valueSpan.textContent = value
            } else {
              valueSpan.textContent = JSON.stringify(value)
            }

            infoItem.appendChild(labelSpan)
            infoItem.appendChild(valueSpan)
            detailsContainer.appendChild(infoItem)
          })

          // 更新当前索引
          currentYear = newYear
          currentIndex = newIndex

          // 更新选中状态
          allPhotoItems.forEach((item) => item.classList.remove('selected'))
          photoItem.classList.add('selected')

          // 恢复图片可见性
          setTimeout(() => {
            modalPhoto.classList.remove('transitioning')
          }, 50) // 给浏览器一点时间来应用新的图片源
        }
      }, 150) // 等待淡出效果完成
    }

    // 绑定关闭事件
    modalOverlay.addEventListener('click', closeModal)

    // 键盘事件处理
    document.addEventListener('keydown', (e) => {
      if (!modal.classList.contains('active')) return

      switch (e.key) {
        case 'Escape':
          closeModal()
          break
        case 'ArrowRight':
        case 'ArrowDown':
          navigatePhotos(1) // 下一张
          e.preventDefault()
          break
        case 'ArrowLeft':
        case 'ArrowUp':
          navigatePhotos(-1) // 上一张
          e.preventDefault()
          break
      }
    })

    // 绑定缩略图点击事件
    allPhotoItems.forEach((item) => {
      item.addEventListener('click', () => {
        const [year, index] = item.getAttribute('data-photo-id').split('-')
        const cat = catsByYear[year][parseInt(index)]
        openModal(cat, item)
      })
    })
  })
</script>

<style>
  .photo-item.selected .photo-frame {
    border-color: hsl(var(--primary));
    box-shadow:
      0 0 0 1px hsl(var(--primary)),
      0 4px 8px rgba(0, 0, 0, 0.1);
    transform: translateY(-2px);
  }

  /* 响应式调整 */
  @media (max-width: 1200px) {
    .gallery-container {
      grid-template-columns: 1fr 350px;
    }
  }

  @media (max-width: 900px) {
    .gallery-container {
      grid-template-columns: 1fr;
    }

    .photos-grid {
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    }
  }

  @media (max-width: 600px) {
    .photos-grid {
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 1rem;
    }

    .photo-frame {
      padding: 0.5rem;
    }
  }
</style>
