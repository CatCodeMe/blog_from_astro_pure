---
import { Image } from 'astro:assets'

import { PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Button, Card, Icon, Label } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import Section from '@/components/home/Section.astro'
import SkillLayout from '@/components/home/SkillLayout.astro'
import avatar from '@/assets/avatar.jpg'
import config from '@/site-config'

const languages = [
  { name: 'Java', icon: 'devicon:java' },
  { name: 'Zig', icon: 'devicon:zig' },
  { name: 'Python', icon: 'devicon:python' },
  { name: 'Shell', icon: 'devicon:bash' }
]

const backend = [
  { name: 'Spring', icon: 'devicon:spring' },
  { name: 'Redis', icon: 'devicon:redis' },
  { name: 'ClickHouse', icon: 'devicon:clickhouse' },
  { name: 'Mysql', icon: 'devicon:mysql' },
  { name: 'Apache Spark', icon: 'devicon:apachespark' }
]

const ide = [
  { name: 'VSCode', icon: 'devicon:vscode' },
  { name: 'IntelliJ IDEA', icon: 'devicon:intellij' }
]

const MAX_POSTS = 10
const allPosts = await getBlogCollection()
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS)
---

<PageLayout meta={{ title: 'Home' }} highlightColor='#da9d0c'>
  <main class='flex w-full flex-col items-center'>
    <section class='animate mb-10 flex flex-col items-center gap-y-7' id='content-header'>
      <Image
        src={avatar}
        alt='profile'
        class='size-28 rounded-full border p-1 object-cover'
        loading='eager'
      />

      <div class='flex flex-col items-center gap-y-4'>
        <h1 class='text-3xl font-bold'>{config.author}</h1>
        <div class='flex flex-wrap justify-center gap-x-7 gap-y-3'>
          <Label title='Beijing, China'>
            <Icon name='location' class='size-5' slot='icon' />
          </Label>
          <Label
            title='Source code'
            as='a'
            href='https://github.com/cworld1/astro-theme-pure'
            target='_blank'
          >
            <Icon name='github' class='size-5' slot='icon' />
          </Label>
        </div>
      </div>

      {/* Get template */}
      <div
        class='flex flex-row items-center gap-x-3 rounded-full border bg-background px-4 py-2 text-sm shadow-sm transition-shadow hover:shadow-md'
      >
        <span class='relative flex items-center justify-center'>
          <span
            class='absolute size-2 animate-ping rounded-full border border-red-400 bg-green-400 opacity-75'
          ></span>
          <span class='size-2 rounded-full bg-green-400'></span>
        </span>
        <p class='font-medium text-muted-foreground'>五帝三皇神圣事,骗了无涯过客</p>
      </div>
    </section>

    <div id='content' class='animate flex flex-col gap-y-10 md:w-4/5 lg:w-5/6'>
      <Section title='About'>
        <p class='text-muted-foreground'>Developer</p>
        <p class='text-muted-foreground'>
          I'm a software engineer based in Beijing, China. I'm passionate about programming and
          open-source. I'm currently working on a few projects and learning new things every day.
        </p>
        <Button title='More about me' class='w-fit self-end' href='/about' style='ahead' />
      </Section>
      {
        allPostsByDate.length > 0 && (
          <Section title='Posts'>
            <ul class='flex flex-col gap-y-1.5 sm:gap-y-2'>
              {allPostsByDate.map((p) => (
                <li class='flex flex-col gap-x-2 sm:flex-row'>
                  <PostPreview post={p} />
                </li>
              ))}
            </ul>
            <Button title='More posts' class='w-fit self-end' href='/blog' style='ahead' />
          </Section>
        )
      }

      <Section title='Skills'>
        <SkillLayout title='Languages' skills={languages} />
        <SkillLayout title='Backend' skills={backend} />
        <SkillLayout title='Ide' skills={ide} />
      </Section>

      <Section title=''>
        <Card
          class='bg-gradient-to-br from-[#faf6f1] to-[#e6d5bc] dark:from-[#2d2418] dark:to-[#1a1612] border-[#d4c5a9] dark:border-[#4a3f2c]'
        >
          {
            (
              <div class='flex flex-col gap-y-3'>
                <div class='text-center'>
                  <h2 class='text-xl font-medium text-[#6b573c] dark:text-[#d2b48c]'>
                    贺新郎·读史
                  </h2>
                  <p class='text-sm text-[#8b7355] dark:text-[#a08b6c] mt-2'>毛主席 / 1964</p>
                </div>

                <div class='flex flex-col gap-y-3 text-[#6b573c] dark:text-[#b9a89c]'>
                  <div class='flex flex-col gap-y-2'>
                    <div class='flex flex-col space-y-1'>
                      <p class='indent-8'>
                        人猿相揖别，只几个石头磨过，小儿时节。铜铁炉中翻火焰，为问何时猜得？
                        不过几千寒热。人世难逢开口笑，上疆场彼此弯弓月。流遍了，郊原血。
                      </p>
                    </div>
                  </div>

                  <div class='flex flex-col gap-y-2'>
                    <div class='flex flex-col space-y-1'>
                      <p class='indent-8'>
                        一篇读罢头飞雪，但记得斑斑点点，几行陈迹。五帝三皇神圣事，骗了无涯过客。
                        有多少风流人物？盗跖庄蹻流誉后，更陈王奋起挥黄钺。歌未竟，东方白。
                      </p>
                    </div>
                  </div>
                </div>
              </div>
            )
          }
        </Card>
      </Section>
    </div>
    <!-- <Quote class='mt-12' /> -->
  </main>
</PageLayout>
