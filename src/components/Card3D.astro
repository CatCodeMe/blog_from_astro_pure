---
interface Props {
  src: string
  containerClass?: string
}

const { src, containerClass = '' } = Astro.props
---

<div class:list={['cards-container', containerClass]}>
  <div class='steam-card-3d'>
    <img src={src} />
  </div>
</div>

<script is:inline>
  function map(val, minA, maxA, minB, maxB) {
    return minB + ((val - minA) * (maxB - minB)) / (maxA - minA)
  }

  function Card3D(card, event) {
    let img = card.querySelector('img')
    let imgRect = card.getBoundingClientRect()
    let width = imgRect.width
    let height = imgRect.height
    let mouseX = event.offsetX
    let mouseY = event.offsetY
    let rotateY = map(mouseX, 0, width, -25, 25)
    let rotateX = map(mouseY, 0, height, 25, -25)
    let brightness = map(mouseY, 0, height, 1.5, 0.5)

    img.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`
    img.style.filter = `brightness(${brightness})`
  }

  document.querySelectorAll('.steam-card-3d').forEach((card) => {
    card.addEventListener('mousemove', (event) => {
      Card3D(card, event)
    })

    card.addEventListener('mouseleave', (event) => {
      let img = card.querySelector('img')
      img.style.transform = 'rotateX(0deg) rotateY(0deg)'
      img.style.filter = 'brightness(1)'
    })
  })
</script>

<style>
  .cards-container {
    width: 100%;
    position: relative;
  }

  /* 单独使用时的样式 */
  :not(.cards-desk) > .cards-container {
    max-width: 300px;
    margin: 0 auto;
  }

  .steam-card-3d {
    margin: 0;
    transform: scale(1);
    perspective: 600px;
    transition: all 250ms ease-out;
    position: relative;
    z-index: 1;
  }

  .steam-card-3d:hover {
    z-index: 10;
    transform: scale(1.3);
    transform-origin: center center;
  }

  .steam-card-3d:first-child:hover {
    transform-origin: left center;
  }

  .steam-card-3d:last-child:hover {
    transform-origin: right center;
  }

  /* 基础图片样式 */
  .steam-card-3d img {
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 2px solid var(--primary, #0074e0);
    transition: all 250ms ease-out;
    object-fit: cover;
  }

  /* 单独使用时的图片样式 */
  :not(.cards-desk) .steam-card-3d img {
    width: 300px;
    height: 225px;
    object-fit: cover;
  }
</style>
