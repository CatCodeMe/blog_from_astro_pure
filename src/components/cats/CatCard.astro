---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

interface Props {
  cat: {
    name: string
    image: ImageMetadata
    imagePath: string
    description: string
    age: string
    breed: string
    personality: string
    width: number
    height: number
  }
}

const { cat } = Astro.props
---

<div
  class='mt-4 hidden rounded-lg border bg-card p-6 opacity-0 transition-all duration-300 group-hover:block group-hover:opacity-100'
>
  <div class='flex gap-6'>
    <div class='w-1/2'>
      {/* 左侧大图 */}
      <Image
        src={cat.image}
        alt={cat.name}
        width={cat.width}
        height={cat.height}
        class='h-full w-full rounded-lg object-cover'
        loading='lazy'
      />
    </div>

    <div class='w-1/2 space-y-4'>
      <h3 class='text-2xl font-bold'>{cat.name}</h3>
      <p class='text-muted-foreground'>{cat.description}</p>

      <div class='space-y-2'>
        <div class='flex justify-between'>
          <span class='font-medium'>Age:</span>
          <span>{cat.age}</span>
        </div>
        <div class='flex justify-between'>
          <span class='font-medium'>Breed:</span>
          <span>{cat.breed}</span>
        </div>
        <div class='flex justify-between'>
          <span class='font-medium'>Personality:</span>
          <span>{cat.personality}</span>
        </div>
      </div>
    </div>
  </div>
</div>
