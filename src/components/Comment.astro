---
import config from '../site.config'

const walineClientPath = `${config.npmCDN}/@waline/client@v3/dist/waline.js`
const walineStylePath = `${config.npmCDN}/@waline/client@v3/dist/waline.css`
const { waline } = config.integ

// 构建完整的 emoji CDN 路径
const emojiMaps = {
  weibo: `${config.npmCDN}/@waline/emojis@1.2.0/weibo`,
  bilibili: `${config.npmCDN}/@waline/emojis@1.2.0/bilibili`,
  qq: `${config.npmCDN}/@waline/emojis@1.2.0/qq`,
  tieba: `${config.npmCDN}/@waline/emojis@1.2.0/tieba`
}
---

{
  waline.enable && (
    <>
      <link rel='stylesheet' href={walineStylePath} />
      <div class='waline-container'>
        <div id='waline' />
      </div>
    </>
  )
}

<script define:vars={{ walineConfig: waline, walineClientPath, emojiMaps }}>
  ;(async function () {
    if (!walineConfig.enable) return

    try {
      const { init } = await import(walineClientPath)

      init({
        el: '#waline',
        serverURL: walineConfig.server,
        requestOptions: {
          credentials: 'include'
        },
        login: 'optional', // 设置为可选登录
        emoji: [
          '//unpkg.com/@waline/emojis@1.2.0/weibo'
          // '//unpkg.com/@waline/emojis@1.2.0/bilibili',
          // '//unpkg.com/@waline/emojis@1.2.0/qq',
          // '//unpkg.com/@waline/emojis@1.2.0/tieba'
        ],
        dark: 'html.dark',
        meta: ['nick', 'mail'], // 设置必填项
        requiredMeta: ['nick'], // 只要求昵称必填
        lang: 'zh-CN',
        imageUploader: false, // 禁用图片上传
        ...walineConfig.additionalConfigs
      })
    } catch (error) {
      console.error('Failed to initialize Waline:', error)
    }
  })()
</script>

<style>
  .waline-container {
    margin: 2rem 0;
  }

  /* 明亮主题 */
  :global(#waline) {
    --waline-font-size: 16px;
    --waline-white: var(--background);
    --waline-light-grey: var(--muted);
    --waline-dark-grey: var(--muted-foreground);

    --waline-theme-color: var(--primary);
    --waline-active-color: var(--primary);

    --waline-color: var(--foreground);
    --waline-bg-color: var(--background);
    --waline-bg-color-light: var(--muted);
    --waline-border-color: var(--border);
    --waline-disable-bg-color: var(--muted);
    --waline-disable-color: var(--muted-foreground);

    --waline-avatar-size: 3.25rem;
    --waline-m-avatar-size: calc(var(--waline-avatar-size) * 9 / 13);

    --waline-border: 1px solid var(--waline-border-color);
    --waline-avatar-radius: 50%;
    --waline-box-shadow: none;
  }

  /* 暗色主题 */
  :global(html.dark #waline) {
    --waline-white: var(--background);
    --waline-light-grey: var(--muted);
    --waline-dark-grey: var(--muted-foreground);

    --waline-text-color: var(--foreground);
    --waline-bgcolor: var(--background);
    --waline-bgcolor-light: var(--muted);

    --waline-border-color: var(--border);
    --waline-disable-bgcolor: var(--muted);
    --waline-disable-color: var(--muted-foreground);
  }

  /* 评论框动画 */
  :global(.wl-panel) {
    transition: all 0.15s ease;
  }

  /* 评论框焦点样式 */
  :global(.wl-panel:focus-within) {
    background: var(--background);
    box-shadow: 0 0 0 2px var(--primary);
  }

  /* 按钮悬停效果 */
  :global(.wl-btn:hover) {
    opacity: 0.8;
  }

  /* 头像悬停效果 */
  :global(.wl-avatar) {
    transition: transform 0.2s ease;
  }

  :global(.wl-avatar:hover) {
    transform: scale(1.1);
  }
</style>
