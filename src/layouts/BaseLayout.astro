---
import { Mermaid } from '@/custom/components/advanced'
import { Footer, Header, ThemeProvider } from '@/custom/components/basic'

import type { SiteMeta } from 'astro-pure/types'
import BaseHead from '@/components/BaseHead.astro'
import config from '@/site-config'

// Import the global.css file here so that it is included on
// all pages through the use of the <BaseLayout /> component.
import '@/assets/styles/app.css'
import '@/assets/styles/callout.css'
import '@/assets/styles/expressive-code.css'
import '@/assets/styles/waline.css'
import '@/assets/styles/internal-link.css'
import '@/assets/styles/external-link.css'
import '@/assets/styles/mermaid.css'

interface Props {
  meta: SiteMeta
  highlightColor?: string
}

const {
  meta: { articleDate, description = config.description, ogImage, title },
  highlightColor
} = Astro.props
---

<html lang={config.locale.lang}>
  <head>
    <BaseHead {articleDate} {description} {ogImage} {title} />
    <ThemeProvider />
  </head>

  <body class='flex justify-center bg-background text-foreground'>
    {
      highlightColor && (
        <div
          id='highlight-gradient'
          class='pointer-events-none absolute start-0 top-0 z-0 h-screen w-full opacity-25'
          style={`background-image:linear-gradient(${highlightColor},transparent)`}
        />
      )
    }
    <div class='w-full max-w-[70rem] px-4 sm:px-7 lg:px-10'>
      <Header />
      <slot />
      <Mermaid />
      <Footer />
    </div>

    {/* Set highlight color */}
    <style define:vars={{ highlightColor }}>
      :global(.highlight) {
        color: var(--highlightColor, hsl(var(--primary) / var(--un-text-opacity))) !important;
      }
      :global(.highlight-bg) {
        background-color: var(
          --highlightColor,
          hsl(var(--primary) / var(--un-text-opacity))
        ) !important;
      }
    </style>

    <script>
      import { initMermaid } from '@/plugins/mermaid-viewer'

      initMermaid()
    </script>

    <!-- <style is:global>
      .mermaid-wrapper {
        @apply relative mt-4 rounded-lg border border-border bg-muted/30 overflow-hidden;
      }

      .mermaid-toolbar {
        @apply absolute right-2 top-2 flex gap-1 p-1 rounded-md bg-background/80 backdrop-blur-sm 
               border border-border shadow-sm;
        z-index: 1;
      }

      .mermaid-toolbar button {
        @apply p-1.5 rounded-md hover:bg-muted transition-colors;
      }

      .mermaid-toolbar button svg {
        @apply opacity-75;
      }

      .mermaid-toolbar button:hover svg {
        @apply opacity-100;
      }

      .mermaid-container {
        @apply p-4 overflow-auto;
      }

      .mermaid {
        @apply mx-auto transition-transform duration-200;
        transform-origin: center;
      }

      :global(.dark) .mermaid {
        @apply brightness-90;
      }

      .hidden {
        display: none;
      }
    </style> -->
  </body>
</html>
